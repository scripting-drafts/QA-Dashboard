#!/usr/bin/env bash
# Block pushes to main when the local release tag trails the pushed commit.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
status=0

while read -r local_ref local_sha remote_ref remote_sha || [[ -n "${local_ref:-}" ]]; do
  [[ "$remote_ref" == "refs/heads/main" ]] || continue
  [[ "$local_sha" == *[!0]* ]] || continue
  if ! python3 "$root/tools/check_release_tag.py" --root "$root" --commit "$local_sha"; then
    status=1
  fi
done

exit "$status"
