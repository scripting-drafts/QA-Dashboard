{
  "name": "qa-dashboard",
  "productName": "QA Dashboard",
  "version": "0.5.9",
  "private": true,
  "description": "Electron dashboard for QA Sentinels",
  "desktopName": "qa-dashboard.desktop",
  "license": "MIT",
  "author": "Gerard Sala",
  "repository": {
    "type": "git",
    "url": "https://github.com/scripting-drafts/QA-Dashboard.git"
  },
  "homepage": "https://github.com/scripting-drafts/QA-Dashboard",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "pack": "electron-builder --publish never",
    "pack:linux": "electron-builder --linux --publish never",
    "pack:win": "electron-builder --win --publish never",
    "pack:mac": "electron-builder --mac --publish never",
    "pack:logs": "scripts/build-logs.sh",
    "pack:logs:linux": "electron-builder --config electron-builder-logs.yml --linux --publish never",
    "pack:logs:win": "electron-builder --config electron-builder-logs.yml --win --publish never",
    "pack:logs:mac": "electron-builder --config electron-builder-logs.yml --mac --publish never",
    "prerelease": "scripts/build-prerelease.sh"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "^26.18.0"
  }
}
